        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/api\\/keys(\\.json)?[\\/#\\?]?$",
          "originalSource": "/api/keys"
        },
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/api\\/keys(?:\\/((?:[^\\/#\\?]+?)(?:\\/(?:[^\\/#\\?]+?))*))?(\\.json)?[\\/#\\?]?$",
