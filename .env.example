# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Streaming deadlines in milliseconds, per attempt. Standard SSE routes and
# adapters that use the shared settings can spend up to 16 minutes in each of
# the header and first-output phases with the example values below.
# STREAM_HEADERS_TIMEOUT_MS=960000
# STREAM_FIRST_CHUNK_TIMEOUT_MS=960000
# STREAM_STALL_TIMEOUT_MS=360000
# STREAM_TERMINAL_GRACE_MS=3000
# STREAM_HEARTBEAT_INTERVAL_MS=15000
# Header precedence: streaming override, provider timeout, FETCH_CONNECT_TIMEOUT_MS (default 60000).
# First usable output defaults to 200000 ms. Preflight can hold up to 1 MiB of preamble.
# Set heartbeat to 0 to disable comments. Comments begin after usable output.
# Terminal grace is the wait for a Chat usage trailer after finish_reason. 0 closes immediately.
# Client, reverse proxy, relay, and provider deadlines apply independently.
# Some native adapters also have their own connection or total request limits.

# Pre-output retries with exponential backoff. 0 attempts keeps the preflight check.
# STREAM_PRECONTENT_RETRY_ATTEMPTS=3
# STREAM_PRECONTENT_RETRY_DELAY_MS=2000
# STREAM_PRECONTENT_RETRY_MAX_DELAY_MS=30000
# Codex uses its own SSE retry budget from the 503 policy below.
# EMPTY_PEEK_DEADLINE_MS=45000

# HTTP response retries. Provider entries can override these values.
# 400 retries are opt-in. The 502 budget also covers fetch errors before headers.
# HTTP_400_RETRY_ATTEMPTS=0
# HTTP_400_RETRY_DELAY_MS=1000
# HTTP_500_RETRY_ATTEMPTS=3
# HTTP_500_RETRY_DELAY_MS=2000
# HTTP_502_RETRY_ATTEMPTS=3
# HTTP_502_RETRY_DELAY_MS=3000
# HTTP_503_RETRY_ATTEMPTS=3
# HTTP_503_RETRY_DELAY_MS=2000
# HTTP_504_RETRY_ATTEMPTS=2
# HTTP_504_RETRY_DELAY_MS=3000

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
