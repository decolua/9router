# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
# Dev default: if INITIAL_PASSWORD is not set, the source code falls back to a
# hardcoded dev password (see src/app/api/auth/login/route.js). For any real
# deploy, set INITIAL_PASSWORD to a strong value here.
INITIAL_PASSWORD=change-me-to-a-strong-password
# DATA_DIR is OPTIONAL — leave it unset (the assignment below is commented out)
# to use the per-user default ~/.9router (Windows: %APPDATA%\9router), which the
# runtime user can always create. Never set it to the literal "~/.9router":
# Node's fs does not expand "~" and would create a directory named "~".
# If you do set it, the path must be creatable and writable by the runtime user —
# the app fails fast at boot when it is not (EACCES). A system path needs the
# directory created first, e.g.
#   sudo mkdir -p /var/lib/9router && sudo chown "$USER" /var/lib/9router
# Docker/compose ignores this file's value: docker-compose.yml sets the
# container's DATA_DIR=/app/data via `environment:`.
# DATA_DIR=/var/lib/9router

# Recommended runtime variables
# PORT PRECEDENCE: Next loads .env AFTER process env, so for values the app
# reads itself THIS FILE's value wins over an exported PORT env var. The
# package.json dev scripts' `${PORT:-20128}` shell expansion resolves BEFORE
# next starts, so an exported PORT does override the script's own default —
# but once next reads PORT itself, the line below wins. Keep it 20128
# (scripts/check-port-consistency.mjs asserts this; `npm run test:ports`).
PORT=20128
NODE_ENV=production
# docker-compose.yml host-port overrides (host side only; container ports fixed).
# PORT and HEADROOM_PORT only affect compose port mappings, not the app config.
# HEADROOM_PORT=18787

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Additional auth/security variables (all OPTIONAL unless noted; see
# docs/ARCHITECTURE.md "Security environment variables" for full semantics)
# JWT_SECRET and INITIAL_PASSWORD above are REQUIRED (set them on any real deploy).
# SHUTDOWN_SECRET=   # Bearer token for POST /api/shutdown in non-production (401 if unset; disabled in production)
# ROUTER_API_KEY=    # API key the MITM proxy (src/mitm/) sends to the local router when one is required
# TRUST_PROXY=       # "true" only behind a reverse proxy that overwrites X-Forwarded-For with the real client IP (login rate-limiting trusts XFF)
# KIMI_OAUTH_CLIENT_ID=          # Kimi OAuth client-id override (forks); registry default otherwise
# KIMI_CODING_OAUTH_CLIENT_ID=   # Kimi Code OAuth client-id override (takes precedence over KIMI_OAUTH_CLIENT_ID)

# Request-details store bounds (deep per-request inspection records, written by
# src/lib/db/repos/requestDetailsRepo.js while observability is enabled). A value
# configured in the dashboard settings wins over these; the env value is the
# fallback. Buffered records flush to SQLite when the buffer reaches
# OBSERVABILITY_BATCH_SIZE records or once OBSERVABILITY_FLUSH_INTERVAL_MS has
# elapsed, whichever comes first.
# OBSERVABILITY_MAX_RECORDS=200        # retained requestDetails rows; oldest rows deleted beyond the cap
# OBSERVABILITY_BATCH_SIZE=20          # buffered records that trigger an immediate flush
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000 # max ms a record waits in the write buffer before flushing
# OBSERVABILITY_MAX_JSON_SIZE=5        # KB cap per stored request/response JSON field (larger fields truncated)

# INTERNAL - do not set. custom-server.js generates this per-process secret at
# boot to prove the x-9r-real-ip header was stamped from the TCP socket rather
# than sent by a client (see docs/ARCHITECTURE.md, "Security-Sensitive
# Boundaries"). It is not an operator knob: the production wrapper overwrites
# any .env value per process, and no token needs to be provided.
# NINEROUTER_PEER_TOKEN=

# Upstream fetch deadline in milliseconds for video job submission/polling HTTP
# round-trips (open-sse/handlers/videoCore.js). Bounds only the HTTP call, not
# upstream video rendering. Raise it only for unusually slow video providers.
# VIDEO_FETCH_TIMEOUT_MS=120000

# Optional dashboard URL matching variables
# Optional dashboard URL used for matching the configured base URL.
# Server-side variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Public-compatible variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Federation variables (docs/federation-spec.md §4 — optional unless FEDERATION_MODE
# is set; defaults shown). Inert unless FEDERATION_MODE is set; standalone is the
# default (zero behavior change).
#
# docker-compose.federation.yml reads the four shared secrets below via env_file
# (cp .env.example .env, then edit). FEDERATION_TOKEN, JWT_SECRET, API_KEY_SECRET
# and INITIAL_PASSWORD MUST be identical on every federation instance (central +
# all edges) — see docs/FEDERATION.md §3 Env matrix.
FEDERATION_TOKEN=change-me-to-a-long-random-federation-token # Shared secret, Bearer auth edge<->central (never reuse JWT_SECRET/API_KEY_SECRET)
# FEDERATION_MODE=standalone            # standalone | central | edge
# FEDERATION_CENTRAL_URL=               # Central base URL (edge only)
# FEDERATION_EDGE_ID=                   # Edge identity (default: node-machine-id)
# FEDERATION_SYNC_INTERVAL_MS=5000      # Delta poll interval
# FEDERATION_HEARTBEAT_INTERVAL_MS=2000 # Verify heartbeat interval
# FEDERATION_OUTAGE_THRESHOLD_MS=15000  # Consecutive-failure window -> DEGRADED
# FEDERATION_QUEUE_MAX=10000            # pendingWrites cap
# FEDERATION_REPLAY_BATCH_SIZE=50       # Replay batch on recovery
# FEDERATION_REDACT_FIELDS=             # Optional JSON-path redaction (proxy-only edges)

# Updater / self-host lifecycle (see docs/ARCHITECTURE.md "Updater / self-host
# lifecycle variables"). Defaults are injected by the app (UPDATER_CONFIG);
# override only for packaged/self-host deployments.
# UPDATER_PKG_NAME=9router
# UPDATER_PORT=20129                  # updater status HTTP (loopback only)
# UPDATER_APP_PORT=20128              # app port the updater probes for exit/ready
# TRAY_MODE=                          # "1" = tray-launched (relaunch keeps --tray)
# LOG_LEVEL=INFO                      # DEBUG | INFO | WARN | ERROR (SSE/cloud logger)
# DISABLE_BACKGROUND_TOKEN_REFRESH=   # truthy disables background token refresh loop
# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
