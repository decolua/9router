# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
# observability is settings-first. These variables now supply
# only the INITIAL default, used while the matching key has never been written via
# PATCH /api/settings (or /dashboard/profile). Once the operator sets it, the stored
# setting wins and the env var is ignored — it can no longer make the toggle inert.
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Raw upstream SSE frame capture (initial default for `observabilityFrameLogging`).
# Sub-switch of observability: master off => frames off. Writes one folder per request to
# $DATA_DIR/logs/frames containing the unparsed provider frames, request/response bodies
# and headers. High volume and prompt-bearing; treat the directory as sensitive.
OBSERVABILITY_FRAME_LOGGING=false
# Two ROLLING caps bound the artifacts. Neither switches capture off — once frame logging
# is on it keeps capturing until an operator turns it off; these only decide how much is
# kept. Whichever binds first wins.
#   time:  keep the last N hours of frame logs (initial default for observabilityRetentionHours)
#   size:  keep at most N MB in the directory, trimming oldest session first
#          (initial default for observabilityMaxLogSizeMb)
OBSERVABILITY_RETENTION_HOURS=12
OBSERVABILITY_MAX_LOG_SIZE_MB=512
# Where the frame dumps go.
# OBSERVABILITY_FRAME_LOG_DIR=/var/lib/9router/logs/frames
# Hard stop: frame writing pauses (traffic is unaffected) if the log filesystem has less
# than this free, so frame logs can never fill the volume that data.sqlite lives on.
OBSERVABILITY_FRAME_LOG_MIN_FREE_MB=1024
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
