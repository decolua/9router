# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true

# Optional per-API-key usage and cost metrics (OpenTelemetry). Nothing configured => nothing
# is created or exported. Metrics: ninerouter.requests, ninerouter.tokens (type=prompt|completion|
# cached|reasoning|cache_creation), ninerouter.cost.usd. Attributes: key_name (the key's NAME,
# "no-key" or "unknown-key"; never the key value), model, provider, endpoint,
# status (ok | empty | no_usage | error | aborted).
# Active keys with a spend limit also get ninerouter.key.limit.used_ratio (gauge: spend in the
# current day|month window / limit, 1 = at the limit; alert on max per key_name, e.g. Prometheus
# `max by (key_name) (ninerouter_key_limit_used_ratio) > 0.9`) and ninerouter.key.limit.refused
# (counter of 429 refusals). Both carry key_name and window only. The gauge reports every active
# key with a limit, but >= 1 only means refusals where the limit is enforced (restricted keys whose
# models are all priced), so alert on it together with the refused counter. Keys sharing a name
# report the highest ratio. Spend uses the same query, window and limit as enforcement; each side
# caches it for up to 5 s on its own. A key that stops being reported (deleted, deactivated,
# renamed, limit removed) or whose spend read fails shows NaN once, then is no longer reported
# (cumulative readers keep exporting it as NaN until restart; delta drops it). Alerts must not
# treat NaN as a breach.
#
# OTLP push (http/protobuf) to any OTLP backend or OTel Collector. On when either endpoint is
# set and OTEL_METRICS_EXPORTER != none.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318               # /v1/metrics is appended
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://collector:4318/v1/metrics  # used as-is, wins
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<secret>                     # or OTEL_EXPORTER_OTLP_METRICS_HEADERS
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative    # cumulative (default) | delta (some backends, e.g. New Relic, want delta)
# OTEL_METRIC_EXPORT_INTERVAL=60000                               # ms, default 60000
# OTEL_METRIC_EXPORT_TIMEOUT=30000                                # ms, capped at the interval
# OTEL_METRICS_EXPORTER=none                                      # force OTLP off
# OTEL_SERVICE_NAME=9router                                       # default 9router
#
# Prometheus scrape endpoint GET /metrics (cumulative). Off => 404. Not behind the dashboard
# login; it has its own password instead: empty => open; set => "Authorization: Bearer <pw>"
# or Basic auth with any username and <pw>.
OBSERVABILITY_METRICS_ENDPOINT_ENABLED=false
OBSERVABILITY_METRICS_ENDPOINT_PASSWORD=
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
