# ==========================================================
# 🔐 Ключи провайдеров 9Router
# Скопируйте этот файл в .env и заполните своими ключами:
#   cp .env.example .env
#
# После обновления upstream выполните:
#   npm run seed
# ==========================================================

# RouterAI (основной провайдер для оркестратора)
# Получите ключ на https://routerai.ru
# PROVIDER_ROUTERAI_KEY=sk-...
# PROVIDER_ROUTERAI_KEY2=sk-...

# OpenCode (бесплатные модели, без авторизации)
# Бесплатно: deepseek-v4-flash-free, north-mini-code-free, mimo-v2.5-free, big-pickle
# Для vision и сложных задач требуется OpenCode Go (ключ ниже)
# PROVIDER_OPENCODE_KEY=sk-...

# Cloudflare
# PROVIDER_CLOUDFLARE_KEY=cfut_...
# PROVIDER_CLOUDFLARE_KEY2=cfk_...

# 9Router
# PROVIDER_9ROUTER_KEY=sk-...

# Vercel
# PROVIDER_VERCEL_KEY=vcp_...

# ==========================================================
# 🤖 Ollama — локальные и облачные модели
# Убедитесь что Ollama запущен: ollama serve
# Для Docker: используйте http://host.docker.internal:11434
# ==========================================================

OLLAMA_BASE_URL=http://localhost:11434

# ==========================================================
# 🎯 Оркестратор (мульти-агентная система)
# Можно переопределить через настройки в UI (/dashboard/orchestrator)
#
# Если ключей провайдеров нет — оркестратор автоматически
# использует Ollama для планирования и ревью.
# ==========================================================

# Supervisor — старшая модель для планирования и распределения задач
# SUPERVISOR_MODEL=deepseek/deepseek-v4-flash
# SUPERVISOR_ENDPOINT=https://routerai.ru
# SUPERVISOR_TEMPERATURE=0.3
# SUPERVISOR_MAX_TOKENS=2000

# Quality Gate — проверка качества результатов (опционально)
# REVIEW_MODEL=deepseek/deepseek-v4-flash
# REVIEW_PROVIDER=routerai
# MIN_QUALITY_SCORE=0.6
# MAX_RETRIES=3