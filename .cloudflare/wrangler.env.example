# Cloudflare Pages Configuration
# This file configures AI Router Proxy for deployment on Cloudflare Pages

# Build settings
FRAMEWORK = "next"
NEXT_VERSION = "16.1.6"

# Build command
BUILD_COMMAND = "npm run build"

# Build output directory
BUILD_OUTPUT_DIR = ".next"

# Environment variables
NODEJS_VERSION = "20"

# Production branch
PRODUCTION_BRANCH = "main"

# Automatic deployments
AUTO_DEPLOY = true
