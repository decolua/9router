{
  "schemaVersion": 1,
  "description": "Machine-readable guardrails for DiepXuan fork custom features that must survive upstream master rebases.",
  "rebaseBaseline": {
    "fork": "diepxuan/9router",
    "upstream": "decolua/9router",
    "forkBranch": "main",
    "upstreamBranch": "master",
    "checkCommand": "node scripts/diepxuan/check-custom-features.mjs"
  },
  "features": [
    {
      "id": "alicode-provider",
      "description": "Alibaba Cloud Coding Plan provider registration and model/test support.",
      "requiredFiles": [
        "src/shared/constants/providers.js",
        "src/shared/constants/config.js",
        "src/diepxuan/shared/constants/providers.js",
        "src/diepxuan/shared/constants/config.js",
        "src/app/api/providers/validate/route.js",
        "src/app/api/providers/[id]/test/testUtils.js",
        "src/app/api/providers/[id]/models/route.js",
        "open-sse/services/usage.js",
        "open-sse/config/providers.js",
        "open-sse/config/providerModels.js",
        "open-sse/diepxuan/services/usage.js",
        "open-sse/diepxuan/services/usageHooks.js",
        "public/providers/alicode.png",
        "public/providers/alicode-intl.png"
      ],
      "requiredPatterns": [
        { "file": "src/shared/constants/providers.js", "pattern": "extendApiKeyProviders" },
        { "file": "src/shared/constants/config.js", "pattern": "extendProviderEndpoints" },
        { "file": "src/diepxuan/shared/constants/providers.js", "pattern": "DIEPXUAN_APIKEY_PROVIDERS" },
        { "file": "src/diepxuan/shared/constants/providers.js", "pattern": "alicode" },
        { "file": "src/diepxuan/shared/constants/providers.js", "pattern": "alicode-intl" },
        { "file": "src/diepxuan/shared/constants/config.js", "pattern": "https://coding\\.dashscope\\.aliyuncs\\.com/v1/chat/completions" },
        { "file": "src/diepxuan/shared/constants/config.js", "pattern": "https://coding-intl\\.dashscope\\.aliyuncs\\.com/v1/chat/completions" },
        { "file": "src/app/api/providers/[id]/test/testUtils.js", "pattern": "case \\\"alicode\\\"|case \\\"alicode-intl\\\"" },
        { "file": "src/app/api/providers/[id]/models/route.js", "pattern": "alicode" },
        { "file": "open-sse/services/usage.js", "pattern": "getDiepXuanUsageForProvider" },
        { "file": "open-sse/diepxuan/services/usageHooks.js", "pattern": "getDiepXuanUsageForProvider" },
        { "file": "open-sse/config/providers.js", "pattern": "alicode" },
        { "file": "open-sse/config/providerModels.js", "pattern": "qwen3\\.5-plus" }
