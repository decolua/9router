      "invariants": [
        { "file": "src/shared/constants/providers.js", "pattern": "APIKEY_PROVIDERS\\s*=\\s*extendApiKeyProviders\\(" },
        { "file": "src/shared/constants/config.js", "pattern": "PROVIDER_ENDPOINTS\\s*=\\s*extendProviderEndpoints\\(" },
        { "file": "open-sse/services/usage.js", "pattern": "getDiepXuanUsageForProvider\\(" }
      ],
      "syntaxCheck": [
        "src/shared/constants/providers.js",
        "src/shared/constants/config.js",
        "src/diepxuan/shared/constants/providers.js",
        "src/diepxuan/shared/constants/config.js",
        "src/app/api/providers/validate/route.js",
        "src/app/api/providers/[id]/test/testUtils.js",
