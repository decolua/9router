# ebRouter client deployment — copy to .env or run install.ps1 / install.sh to generate.
# NEVER commit .env to git.

# Docker image (pin a version for production; update via update.ps1 / update.sh)
# Replace YOUR_GITHUB_ORG with your GitHub username or org (lowercase)
EBROUTER_IMAGE=ghcr.io/rsingh888/ebrouter:0.4.56

# Compose project name (isolates volumes on shared Docker hosts)
COMPOSE_PROJECT_NAME=ebrouter

# App listen port on the host
PORT=20128

# PostgreSQL (internal to Docker network; install.ps1 generates POSTGRES_PASSWORD if empty)
POSTGRES_USER=ebrouter
POSTGRES_PASSWORD=
POSTGRES_DB=ebrouter

# Required secrets — install scripts generate these if left empty
JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=

# Recommended: encrypt provider secrets at rest (openssl rand -base64 32)
# Do NOT change after go-live or encrypted data becomes unreadable.
MASTER_KEY=

# Deployment mode (on-prem installs use onprem)
DEPLOY_MODE=onprem

# Public URL of this instance (use server IP/hostname if not localhost)
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Optional cloud sync (leave empty if unused)
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=

# Security (recommended for company deployments)
REQUIRE_API_KEY=true
AUTH_COOKIE_SECURE=false
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
