# AWS EC2 — ebRouter SaaS
# Copy to deploy/saas/.env and replace YOUR_PUBLIC_IP + secrets.

COMPOSE_PROJECT_NAME=ebrouter-ec2

EBROUTER_IMAGE=ghcr.io/YOUR_ORG/ebrouter:0.4.56

DEPLOY_MODE=saas
BASE_URL=http://YOUR_PUBLIC_IP:20128
NEXT_PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:20128
# Leave SAAS_BASE_DOMAIN unset for path URLs (/o/slug/...)

EBROUTER_BIND=0.0.0.0:20128
AUTH_COOKIE_SECURE=false

POSTGRES_USER=ebrouter
POSTGRES_PASSWORD=
POSTGRES_DB=ebrouter

JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=
MASTER_KEY=

REQUIRE_API_KEY=true
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
API_RATE_LIMIT_PER_MIN=120
API_RATE_LIMIT_PER_KEY_PER_MIN=300

CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=
