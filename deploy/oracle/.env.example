# Oracle Cloud Always Free — ebRouter SaaS demo
# Copy to deploy/saas/.env and replace YOUR_PUBLIC_IP + secrets.
# NEVER commit .env to git.

COMPOSE_PROJECT_NAME=ebrouter-oracle

# Pin your GHCR image (must include linux/arm64 for Ampere VMs)
EBROUTER_IMAGE=ghcr.io/YOUR_ORG/ebrouter:0.4.56

# Path-based multi-tenant URLs (no custom domain required)
# Example: http://203.0.113.10:20128/o/acme/login
DEPLOY_MODE=saas
BASE_URL=http://YOUR_PUBLIC_IP:20128
NEXT_PUBLIC_BASE_URL=http://YOUR_PUBLIC_IP:20128
# Leave SAAS_BASE_DOMAIN unset for path mode

# Expose app on all interfaces (Oracle public IP → port 20128)
EBROUTER_BIND=0.0.0.0:20128

# HTTP demo over IP — set true when using HTTPS + custom domain
AUTH_COOKIE_SECURE=false

# PostgreSQL (internal Docker network)
POSTGRES_USER=ebrouter
POSTGRES_PASSWORD=
POSTGRES_DB=ebrouter

# Required secrets — generate on the server (see deploy/oracle/README.md)
JWT_SECRET=
API_KEY_SECRET=
MACHINE_ID_SALT=
MASTER_KEY=

# Security
REQUIRE_API_KEY=true
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
API_RATE_LIMIT_PER_MIN=120
API_RATE_LIMIT_PER_KEY_PER_MIN=300

# Optional cloud sync
CLOUD_URL=
NEXT_PUBLIC_CLOUD_URL=
