{
  "name": "9router-app",
  "version": "0.5.111",
  "description": "9Router web dashboard",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-20128}",
    "dev:webpack": "next dev --webpack --port ${PORT:-20128}",
    "prebuild": "node scripts/check-node-version.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node scripts/start.mjs",
    "dev:bun": "bun --bun next dev --webpack --port 20128",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "test": "node scripts/check-test-deps.mjs && cd tests && ./node_modules/.bin/vitest run",
    "test:ports": "node scripts/check-port-consistency.mjs",
    "test:e2e": "node tests/federation/e2e.mjs",
    "board:task": "node scripts/board-task.mjs",
    "lint": "eslint .",
    "lint:gate": "node scripts/lint-baseline.mjs",
    "lint:baseline": "node scripts/lint-baseline.mjs --update"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.3.8",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "12.12.0",
    "bcryptjs": "^3.0.3",
    "chalk": "6.0.1",
    "confbox": "^0.3.1",
    "enquirer": "^2.4.1",
    "express": "5.3.0",
    "jose": "^6.2.13",
    "marked": "^18.0.14",
    "material-symbols": "^0.48.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.2",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.4",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.0",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.1.0",
    "sql.js": "^1.15.1",
    "undici": "8.12.3",
    "uuid": "14.0.3",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1154.0",
    "better-sqlite3": "^13.0.3",
    "ajv": "^8.17.1",
    "ws": "^8.18.0"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools \u2014 sql.js is used as fallback at runtime",
  "comment_aws_sdk_credential_providers": "kept in optionalDependencies (npm still installs these by default) and imported lazily in shared/awsCredentials.js \u2014 only AWS Bedrock connections using profile/SSO mode need it; static accessKeyId/secretAccessKey connections never load it",
  "comment_playwright_core": "devDependency only (keeps end-user installs small); open-sse/services/lazyRuntime.js downloads it + wreq-js on first use into <DATA_DIR>/runtime. playwright-core ships no browser binaries (run `npx playwright-core install chromium` or point OBSCURA_CDP_ENDPOINT/cloakbrowser at a stealth engine)",
  "overrides": {
    "dompurify": "3.4.17",
    "@xmldom/xmldom": "0.9.12",
    "qs": "^6.16.0",
    "ip-address": "^10.7.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4",
    "playwright-core": "^1.62.1",
    "wreq-js": "^3.2.0"
  }
}
