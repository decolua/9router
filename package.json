{
	"name": "9router-app",
	"version": "0.5.18",
	"description": "9Router web dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vinext dev --port 20127",
		"build": "vinext build",
		"start": "node server.vinext.js",
		"start:vanilla": "vinext start",
		"start:pm2": "pm2 start ecosystem.config.cjs",
		"stop:pm2": "pm2 delete ecosystem.config.cjs",
		"cli:pack": "npm --prefix cli run pack:cli"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/modifiers": "9.0.0",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@monaco-editor/react": "4.7.0",
		"@xyflow/react": "12.10.1",
		"bcryptjs": "3.0.3",
		"chalk": "5.6.0",
		"confbox": "0.2.4",
		"express": "5.2.1",
		"http-proxy-middleware": "3.0.5",
		"jose": "6.1.3",
		"marked": "18.0.1",
		"material-symbols": "0.44.6",
		"monaco-editor": "0.55.1",
		"node-forge": "1.3.3",
		"node-machine-id": "1.1.12",
		"open": "11.0.0",
		"ora": "9.1.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-is": "16.13.1",
		"react-server-dom-webpack": "19.2.7",
		"recharts": "3.7.0",
		"selfsigned": "5.5.0",
		"socks-proxy-agent": "8.0.5",
		"sql.js": "1.14.1",
		"undici": "8.3.0",
		"uuid": "14.0.0",
		"vinext": "1.0.0-beta.0",
		"zustand": "5.0.10"
	},
	"optionalDependencies": {
		"better-sqlite3": "12.6.2"
	},
	"comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
	"devDependencies": {
		"@tailwindcss/postcss": "4.1.18",
		"@vitejs/plugin-react": "6.0.3",
		"@vitejs/plugin-rsc": "0.5.27",
		"eslint": "9.39.4",
		"postcss": "8.5.15",
		"tailwindcss": "4.3.1",
		"typescript": "7.0.1-rc",
		"vite": "8.1.3"
	},
	"allowBuilds": {
		"better-sqlite3": true,
		"sharp": true,
		"unrs-resolver": true
	}
}
